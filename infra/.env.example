# PostgreSQL
POSTGRES_DB=kaggle_pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline_dev_2024

# Grafana (đổi password trước khi lên production)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin


# Kaggle push (KHÔNG commit token thật — copy file này thành infra/.env rồi điền)
# Lấy token ở https://www.kaggle.com/settings/api → Create New Token (dạng KGAT_...)
KAGGLE_USERNAME=quangcrawler
KAGGLE_API_TOKEN=
# Dataset id cho từng source (owner PHẢI khớp KAGGLE_USERNAME, nếu không push 403).
# Kiểm tra trước khi push: python -m pipeline check-kaggle
ITVIEC_KAGGLE_DATASET=quangcrawler/itviec-jobs
TOPCV_KAGGLE_DATASET=docutee/topcv-it-jobs-vietnam

# Pipeline
PIPELINE_SOURCES=itviec,topcv
PIPELINE_LOAD_DB=1
